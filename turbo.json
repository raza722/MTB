{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["MTB_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {},
    "typecheck": {}
  }
}
