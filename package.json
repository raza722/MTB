{
  "name": "mtb",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mtb/staff dev",
    "dev:teacher": "pnpm --filter @mtb/teacher dev",
    "dev:portal": "pnpm --filter @mtb/portal dev",
    "dev:all": "turbo run dev --filter=@mtb/staff --filter=@mtb/teacher --filter=@mtb/portal",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
